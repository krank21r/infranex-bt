{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/market-data",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/scanner",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/scoring",
      "schedule": "*/15 * * * *"
    }
  ]
}
