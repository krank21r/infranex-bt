{
  "version": 2,
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/scanner",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/scoring",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/market-data",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/analyzer",
      "schedule": "0 0 * * *"
    }
  ]
}
