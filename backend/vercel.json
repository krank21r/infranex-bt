{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "runtime": "python3.11"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py",
      "headers": {
        "Access-Control-Allow-Origin": "$NEXT_PUBLIC_APP_URL",
        "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/market-data",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/scanner",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/scoring",
      "schedule": "*/15 * * * *"
    }
  ],
  "env": {
    "APP_ENV": "production",
    "DEPLOYMENT_MODE": "production",
    "SUPABASE_URL": "@SUPABASE_URL",
    "SUPABASE_ANON_KEY": "@SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY": "@SUPABASE_SERVICE_ROLE_KEY",
    "SUPABASE_JWT_SECRET": "@SUPABASE_JWT_SECRET",
    "DATABASE_URL": "@DATABASE_URL",
    "DATABASE_POOLER_URL": "@DATABASE_POOLER_URL",
    "BITTENSOR_NETWORK": "@BITTENSOR_NETWORK",
    "BITTENSOR_RPC_ENDPOINT": "@BITTENSOR_RPC_ENDPOINT",
    "UPSTASH_REDIS_REST_URL": "@UPSTASH_REDIS_REST_URL",
    "UPSTASH_REDIS_REST_TOKEN": "@UPSTASH_REDIS_REST_TOKEN",
    "GITHUB_TOKEN": "@GITHUB_TOKEN",
    "CORS_ORIGINS": "@CORS_ORIGINS",
    "SECRET_KEY": "@SECRET_KEY",
    "CRON_SECRET": "@CRON_SECRET",
    "RATE_LIMIT_REQUESTS": "@RATE_LIMIT_REQUESTS",
    "RATE_LIMIT_WINDOW_SECONDS": "@RATE_LIMIT_WINDOW_SECONDS",
    "SCANNER_FAST_INTERVAL_SECONDS": "@SCANNER_FAST_INTERVAL_SECONDS",
    "SCANNER_MEDIUM_INTERVAL_SECONDS": "@SCANNER_MEDIUM_INTERVAL_SECONDS",
    "SCANNER_SLOW_INTERVAL_SECONDS": "@SCANNER_SLOW_INTERVAL_SECONDS",
    "DEFAULT_CURRENCY": "@DEFAULT_CURRENCY",
    "USD_TO_INR": "@USD_TO_INR"
  },
  "regions": ["iad1"],
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  }
}
