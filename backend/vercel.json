{
  "version": 2,
  "builds": [
    {
      "src": "app/main.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "runtime": "python3.11"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app/main.py",
      "headers": {
        "Access-Control-Allow-Origin": "$NEXT_PUBLIC_APP_URL",
        "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/market-data",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/scanner",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/scoring",
      "schedule": "*/15 * * * *"
    }
  ],
  "regions": ["iad1"],
  "functions": {
    "app/main.py": {
      "maxDuration": 60
    }
  }
}
