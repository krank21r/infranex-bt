# ============================================
# INFRANEX BT - Backend Production Environment (Vercel + Supabase)
# Set these as Environment Variables in Vercel Dashboard
# ============================================

# --- Application ---
APP_NAME=Infranex BT
APP_ENV=production
DEPLOYMENT_MODE=production
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api

# --- Supabase (Required) ---
# Get these from Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# --- Database (Supabase PostgreSQL) ---
# Get from Supabase Dashboard → Settings → Database → Connection String → URI
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Supabase PgBouncer Pooler (Required for Vercel Serverless)
# Get from Supabase Dashboard → Settings → Database → Connection String → Pooler
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_POOLER_URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# --- Bittensor ---
BITTENSOR_NETWORK=finney
BITTENSOR_RPC_ENDPOINT=wss://entrypoint-finney.opentensor.ai:443

# --- Redis (Upstash for Serverless) ---
# Get from Upstash Console → Redis Database → REST API
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Fallback (not used in production)
REDIS_URL=redis://localhost:6379/0

# --- GitHub (for analyzer) ---
GITHUB_TOKEN=ghp_your_token

# --- CORS ---
# Add your Vercel frontend URL (e.g. https://infranex-bt.vercel.app)
CORS_ORIGINS=https://your-frontend.vercel.app,https://your-backend.vercel.app

# --- Security ---
# Generate with: openssl rand -hex 32
SECRET_KEY=your-32-byte-hex-secret

# --- Cron (Vercel Cron) ---
# Generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# --- Scanner Intervals ---
SCANNER_FAST_INTERVAL_SECONDS=300
SCANNER_MEDIUM_INTERVAL_SECONDS=900
SCANNER_SLOW_INTERVAL_SECONDS=86400

# --- Currency ---
DEFAULT_CURRENCY=INR
USD_TO_INR=83.5

# --- Pagination ---
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100