# Environment variables — copy to .env and fill in real values.
# .env is gitignored and never committed.

# PostgreSQL database (Neon or local Postgres)
# Get your connection string from https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# RunPod API key (server-side only — never prefixed with NEXT_PUBLIC_)
# Get yours at https://www.runpod.io/console/settings/api-tasks
RUNPOD_API_KEY=rpa_your_runpod_api_key_here
