# ============================================
# INFRANEX BT - Environment Configuration
# ============================================
# Copy this file to .env and fill in values
# NEVER commit .env to version control
# ============================================

# --- Application ---
APP_NAME=Infranex BT
APP_ENV=development
DEPLOYMENT_MODE=mock
DEBUG=true
LOG_LEVEL=INFO

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# --- Bittensor ---
BITTENSOR_NETWORK=testnet
BITTENSOR_RPC_ENDPOINT=wss://entrypoint-finney.opentensor.ai:443

# --- Redis / Valkey ---
REDIS_URL=redis://localhost:6379/0

# --- GitHub (for subnet repository analysis) ---
GITHUB_TOKEN=ghp_your_token_here

# --- GPU Provider API Keys ---
RUNPOD_API_KEY=
VASTAI_API_KEY=
TENSORDOCK_API_KEY=
E2E_API_KEY=

# --- Market Data ---
MARKET_API_KEY=
MARKET_API_URL=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_NAME=Infranex BT

# --- Security ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
SECRET_KEY=change-this-to-a-random-secret-key

# --- Scanner Configuration ---
SCANNER_FAST_INTERVAL_SECONDS=300
SCANNER_MEDIUM_INTERVAL_SECONDS=900
SCANNER_SLOW_INTERVAL_SECONDS=86400

# --- Currency ---
DEFAULT_CURRENCY=INR
USD_TO_INR=83.5
