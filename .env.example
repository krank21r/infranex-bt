# Environment variables — copy to .env and fill in real values.
# .env is gitignored and never committed.

# SQLite database file (Prisma). run-dev.sh sets this explicitly for the
# dev server; script runs need it passed on the command line too.
DATABASE_URL=file:/home/z/my-project/infranex-bt/db/custom.db

# Session signing secret for the auth gate (src/lib/auth.ts). Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If missing, a random per-boot secret is used (sessions reset on restart).
APP_SESSION_SECRET=replace-with-48-byte-random-hex

# Master secret for AES-256-GCM encryption at rest (provider API keys,
# webhook channel URLs, host credentials, daemon secrets) — see
# src/lib/devops/crypto.ts. If missing, a random .devops-secret file is
# created next to the project (0600, gitignored).
DEVOPS_SECRET=replace-with-long-random-string

# Public origin of this platform, used when generating the Node Daemon
# install script (src/app/api/daemon/install/route.ts). Optional — the
# install request body can override it.
INFRANEX_PLATFORM_URL=http://localhost:3000

# Optional: RunPod API key as a bootstrap default. Keys for RunPod / Vast.ai
# / Lambda are normally stored encrypted-at-rest through the app itself
# (GPU catalog → provider keys, admin-only).
RUNPOD_API_KEY=rpa_your_runpod_api_key_here
