# ============================================
# INFRANEX BT - Frontend Production Environment
# Copy to .env.production.local and fill in values
# ============================================

# --- API ---
# Vercel deployment URL for the backend (e.g. https://infranex-backend.vercel.app)
NEXT_PUBLIC_API_URL=https://your-backend.vercel.app

# --- Supabase ---
# Get these from Supabase Dashboard → Settings → API
# NEXT_PUBLIC_ prefix = exposed to browser (required for client-side auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# NO prefix = server-only (NEVER exposed to browser)
# Service role key for admin operations (server components, API routes)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
NEXT_PUBLIC_APP_NAME=Infranex BT