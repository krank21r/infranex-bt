// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Local development uses SQLite. For Vercel/Neon deployment, change this
  // to "postgresql" and set DATABASE_URL to your Neon connection string.
  // See README.md "Deployment" section.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Deployment {
  id              String   @id @default(cuid())
  minerName       String
  netuid          Int
  subnetName      String
  gpuModel        String
  provider        String
  status          String   @default("requested")
  progress        Int      @default(0)
  mode            String   @default("mock") // "mock" | "runpod"
  hourlyCost      Float
  monthlyCost     Float
  estimatedRevenue Float   @default(0)
  // Deployment config (JSON string for SQLite): docker image, miner command, ports, env vars
  config          String
  // Provider-side pod/server ID (RunPod pod id, etc.)
  providerPodId   String?
  // Hotkey for the miner
  hotkey          String?
  // Step log: JSON array of { name, label, status, startedAt, completedAt, output }
  steps           String   @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([netuid])
}

model SubnetOverride {
  netuid        Int      @id
  name           String?
  description    String?
  category       String?
  minVramGb      Int?
  recommendedGpu String?
  githubUrl      String?
  website        String?
  tags           String?  // JSON array
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ChainSnapshot {
  id              Int      @id @default(autoincrement())
  blockNumber     Int
  totalSubnets    Int
  scannedSubnets  Int
  neuronCount     Int
  taoPriceUsd     Float
  taoMarketCapUsd Float
  taoChange24h    Float
  subnetsJson     String   // JSON array of LiveSubnetMetrics
  neuronsJson     String   @default("[]") // JSON array of NeuronMetrics
  source          String
  createdAt       DateTime @default(now())

  @@index([createdAt])
}

model WorkerStatus {
  id              Int      @id @default(autoincrement())
  workerName      String
  status          String   // "running" | "completed" | "failed"
  lastRun         DateTime
  durationMs      Int
  tasksProcessed  Int
  error           String?
  createdAt       DateTime @default(now())

  @@index([workerName])
  @@index([createdAt])
}

// Singleton row (id = 1) — Profitability Engine settings, editable from the UI.
// The minimum entry rule lives here, NOT buried in code:
//   net profit < minNetProfitTargetUsd  →  AVOID
model ProfitabilitySettings {
  id                      Int      @id @default(1)
  minNetProfitTargetUsd   Float    @default(300)
  storageMonthlyUsd       Float    @default(15)
  infraMonthlyUsd         Float    @default(0) // 0 = auto by work type
  otherOpexMonthlyUsd     Float    @default(25)
  hardwareMode            String   @default("rent") // "rent" | "owned"
  electricityUsdPerKwh    Float    @default(0.12)
  includeRegistrationBurn Boolean  @default(true)
  amortizeBurnMonths      Int      @default(3)
  riskAdjustment          Boolean  @default(true)
  updatedAt               DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// DevOps Engine — GPU host inventory + the 10-step validation pipeline.
// ---------------------------------------------------------------------------

// A GPU machine the engine controls over SSH (BYO box, colo rig, RunPod pod).
// transport: "ssh" (real machine) | "mock" (simulated host for safe demos)
model GpuHost {
  id              String   @id @default(cuid())
  name            String
  transport       String   @default("ssh") // "ssh" | "mock"
  host            String   // hostname / IP
  port            Int      @default(22)
  user            String   @default("root")
  // Auth secret (password or PEM key), AES-256-GCM encrypted at rest.
  secretEnc       String
  // "password" | "key"
  authMethod      String   @default("password")
  provider        String   @default("byo") // "byo" | "runpod"
  providerPodId   String?
  // Overall pipeline status: "pending" | "validating" | "ready" | "needs_fix" | "failed"
  status          String   @default("pending")
  // Auto-fix safe items (docker/toolkit installs) without per-step approval.
  autoFixSafe     Boolean  @default(false)
  // Last successful inspection summary (gpu model, vram, driver, cuda, os)
  hostInfo        String?  // JSON
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
}

// One row per pipeline step per validation run.
// status: "pending" | "running" | "pass" | "fail" | "fixed" | "skipped"
model HostCheck {
  id          String   @id @default(cuid())
  hostId      String
  runId       String   // groups the steps of one validation run
  step        Int      // 1-10
  name        String
  status      String   @default("pending")
  output      String   @default("") // command output / findings
  remediation String?  // suggested fix (human text) when failed
  durationMs  Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([hostId, runId])
  @@index([hostId, step])
}

// ---------------------------------------------------------------------------
// Subnet Requirements Profiler — what a subnet NEEDS, pulled from the subnet
// itself: chain identity + its GitHub repo (README, requirements.txt,
// pyproject.toml, Dockerfile, repo tree → miner entrypoint). Cached per netuid.
// ---------------------------------------------------------------------------
model SubnetRequirements {
  netuid      Int      @id
  subnetName  String
  profileJson String   // SubnetRequirementsProfile JSON
  confidence  String   @default("medium") // "high" | "medium" | "low"
  sources     String   @default("[]")     // JSON array: "chain" | "github" | "curated"
  fetchedAt   DateTime
  updatedAt   DateTime @updatedAt
}

// One subnet installation on one host — the requirement installer's job record.
// status: "staged" | "running" | "waiting_approval" | "deployed" | "failed" | "stopped"
model HostInstall {
  id               String   @id @default(cuid())
  hostId           String
  netuid           Int
  subnetName       String
  walletName       String
  hotkeyName       String
  status           String   @default("staged")
  requirementsJson String   // snapshot of the profile used to build the plan
  stepsJson        String   @default("[]") // InstallStep[] JSON
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([hostId])
  @@index([netuid])
}
