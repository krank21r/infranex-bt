// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Local development uses SQLite. For Vercel/Neon deployment, change this
  // to "postgresql" and set DATABASE_URL to your Neon connection string.
  // See README.md "Deployment" section.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Deployment {
  id              String   @id @default(cuid())
  minerName       String
  netuid          Int
  subnetName      String
  gpuModel        String
  provider        String
  status          String   @default("requested")
  progress        Int      @default(0)
  mode            String   @default("mock") // "mock" | "runpod"
  hourlyCost      Float
  monthlyCost     Float
  estimatedRevenue Float   @default(0)
  // Deployment config (JSON string for SQLite): docker image, miner command, ports, env vars
  config          String
  // Provider-side pod/server ID (RunPod pod id, etc.)
  providerPodId   String?
  // Hotkey for the miner
  hotkey          String?
  // Step log: JSON array of { name, label, status, startedAt, completedAt, output }
  steps           String   @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([netuid])
}

model SubnetOverride {
  netuid        Int      @id
  name           String?
  description    String?
  category       String?
  minVramGb      Int?
  recommendedGpu String?
  githubUrl      String?
  website        String?
  tags           String?  // JSON array
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ChainSnapshot {
  id              Int      @id @default(autoincrement())
  blockNumber     Int
  totalSubnets    Int
  scannedSubnets  Int
  neuronCount     Int
  taoPriceUsd     Float
  taoMarketCapUsd Float
  taoChange24h    Float
  subnetsJson     String   // JSON array of LiveSubnetMetrics
  neuronsJson     String   @default("[]") // JSON array of NeuronMetrics
  source          String
  createdAt       DateTime @default(now())

  @@index([createdAt])
}

model WorkerStatus {
  id              Int      @id @default(autoincrement())
  workerName      String
  status          String   // "running" | "completed" | "failed"
  lastRun         DateTime
  durationMs      Int
  tasksProcessed  Int
  error           String?
  createdAt       DateTime @default(now())

  @@index([workerName])
  @@index([createdAt])
}

// Singleton row (id = 1) — Profitability Engine settings, editable from the UI.
// The minimum entry rule lives here, NOT buried in code:
//   net profit < minNetProfitTargetUsd  →  AVOID
model ProfitabilitySettings {
  id                      Int      @id @default(1)
  minNetProfitTargetUsd   Float    @default(300)
  storageMonthlyUsd       Float    @default(15)
  infraMonthlyUsd         Float    @default(0) // 0 = auto by work type
  otherOpexMonthlyUsd     Float    @default(25)
  hardwareMode            String   @default("rent") // "rent" | "owned"
  electricityUsdPerKwh    Float    @default(0.12)
  includeRegistrationBurn Boolean  @default(true)
  amortizeBurnMonths      Int      @default(3)
  riskAdjustment          Boolean  @default(true)
  updatedAt               DateTime @updatedAt
}
